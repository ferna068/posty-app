# Servidor
PORT=3000
NODE_ENV=development

# Presupuesto de latencia por llamada a un proveedor (ms)
PROVIDER_HTTP_TIMEOUT_MS=8000

# X / Twitter API v2
TWITTER_API_BASE_URL=https://api.twitter.com

# LinkedIn REST API
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_API_VERSION=202409

# Meta Graph API — Facebook Pages
META_GRAPH_BASE_URL=https://graph.facebook.com
META_API_VERSION=v21.0
# Si se define, se envía appsecret_proof en cada llamada a Meta (recomendado en prod)
META_APP_SECRET=
